# ─────────────────────────────────────────────────
# JARVIS — Environment Variables
# Copy this to .env.local and fill in your keys.
# ─────────────────────────────────────────────────

# LLM Provider: "gemini", "anthropic", or "openai-compatible" (default: gemini)
LLM_PROVIDER=gemini

# ── Google Gemini ──
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model ID — check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.0-flash

# ── Anthropic Claude ──
# Get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model ID — check https://docs.anthropic.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── OpenAI-Compatible (OpenAI, Ollama, LM Studio, vLLM, OpenRouter, Groq, Together) ──
# Base URL for the OpenAI-compatible endpoint (without trailing slash)
# Examples:
#   OpenAI:       https://api.openai.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Groq:         https://api.groq.com/openai/v1
#   Ollama local: http://localhost:11434/v1
#   LM Studio:    http://localhost:1234/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Model ID — e.g., gpt-4o-mini, llama-3.3-70b-versatile, mistral-large, etc.
OPENAI_MODEL=gpt-4o-mini

# ── Optional ──
# Max messages to include as context (default: 50)
MAX_CONTEXT_MESSAGES=50
# Max message length in characters (default: 12000)
MAX_MESSAGE_LENGTH=12000
# Max attachment size in bytes (default: 10MB)
MAX_ATTACHMENT_SIZE=10485760

# ── JARVIS Voice & Audio (TTS) ──
# Cloud TTS Provider: "openai" or "elevenlabs" (fallback: browser)
TTS_PROVIDER=openai

# OpenAI TTS (deep, warm, jolly British butler voice)
OPENAI_API_KEY=
TTS_OPENAI_VOICE=onyx

# ElevenLabs (expressive British male voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB


